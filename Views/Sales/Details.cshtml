@model Team_1_ITI.Models.Sale

@{
    ViewData["Title"] = $"Sale #{Model.SaleID}";
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-back d-inline-flex align-items-center px-3 py-2">
        <i data-lucide="arrow-left" class="me-2" width="16"></i> Back to List
    </a>
</div>

<div class="mb-4">
    <h2 class="mb-1 page-title-main">Sale Order #@Model.SaleID</h2>
    <p class="text-muted small m-0">Generated on @Model.SaleDate.ToString("MMMM dd, yyyy HH:mm")</p>
</div>

<div class="row mb-4">
    <div class="col-md-6">
        <div class="card shadow-sm border-0 rounded-3 h-100">
            <div class="card-body p-4">
                <div class="d-flex align-items-center">
                    <div class="bg-light rounded p-3 me-3 text-theme">
                        <i data-lucide="user" width="24"></i>
                    </div>
                    <div>
                        <span class="custom-form-label d-block mb-1">Customer Information</span>
                        <h5 class="mb-0 table-value-main">@(Model.CustomerInfo ?? "-")</h5>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm border-0 rounded-3 h-100">
            <div class="card-body p-4">
                <div class="d-flex align-items-center">
                    <div class="bg-light rounded p-3 me-3 text-theme">
                        <i data-lucide="calendar-check" width="24"></i>
                    </div>
                    <div>
                        <span class="custom-form-label d-block mb-1">Sale Date</span>
                        <h5 class="mb-0 table-value-main">@Model.SaleDate.ToString("dd/MM/yyyy HH:mm")</h5>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0 rounded-3 mb-4">
    <div class="card-header bg-white py-3 px-4 border-bottom">
        <h6 class="m-0 table-value-main text-uppercase" style="letter-spacing: 0.5px;">Sold Products</h6>
    </div>
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-header-custom">
                <tr>
                    <th class="ps-4 py-3">Product Name</th>
                    <th class="text-center py-3">Quantity</th>
                    <th class="text-end py-3">Unit Price</th>
                    <th class="text-end pe-4 py-3">Line Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.SaleItems)
                {
                    <tr>
                        <td class="ps-4 py-3 fw-medium table-value-main">@item.Product.ProductName</td>
                        <td class="text-center">
                            <span class="badge bg-light text-secondary border">@item.Quantity</span>
                        </td>
                        <td class="text-end text-secondary">$@item.UnitPrice.ToString("N2")</td>
                        <td class="text-end pe-4 fw-bold text-theme">$@((item.Quantity * item.UnitPrice).ToString("N2"))</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="row justify-content-end mb-5">
    <div class="col-md-5 col-lg-4">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-body p-0">
                <table class="table mb-0">
                    <tbody>
                        <tr>
                            <td class="ps-4 py-3 text-secondary fw-bold border-0">Summary</td>
                        </tr>
                        <tr style="background-color: #f0f5f3;">
                            <td class="ps-4 py-3 table-value-main fw-bold fs-6 border-0 rounded-start">Total Amount</td>
                            <td class="text-end pe-4 py-3 text-theme fw-bolder fs-5 border-0 rounded-end">
                                $@Model.TotalAmount.ToString("N2")
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>