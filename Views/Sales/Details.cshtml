@model Team_1_ITI.Models.Sale

@{
    ViewData["Title"] = "Sale Details";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2>Sale Details</h2>

        <a asp-controller="Sales"
           asp-action="Index"
           class="btn btn-secondary">
            Back
        </a>

    </div>

    <div class="card mb-4">

        <div class="card-body">

            <div class="row">

                <div class="col-md-4">

                    <strong>Sale ID</strong>

                    <p>
                        @Model.SaleID
                    </p>

                </div>

                <div class="col-md-4">

                    <strong>Sale Date</strong>

                    <p>
                        @(Model.SaleDate.ToString("dd/MM/yyyy HH:mm"))
                    </p>

                </div>
                

                <div class="col-md-4">

                    <strong>
                        Customer Information
                    </strong>

                    <p>
                        @(Model.CustomerInfo ?? "-")
                    </p>

                </div>

            </div>

        </div>

    </div>

    <h4>Sold Products</h4>

    <table class="table table-bordered">

        <thead>

            <tr>
                <th>Product</th>
                <th>Quantity</th>
                <th>Unit Price</th>
                <th>Line Total</th>
            </tr>

        </thead>

        <tbody>

            @foreach (var item in Model.SaleItems)
            {
                <tr>

                    <td>
                        @item.Product.ProductName
                    </td>

                    <td>
                        @item.Quantity
                    </td>

                    <td>
                        @item.UnitPrice.ToString("0.00")
                    </td>

                    <td>
                        @(
                            (item.Quantity *
                             item.UnitPrice)
                            .ToString("0.00")
                        )
                    </td>

                </tr>
            }

        </tbody>

    </table>

    <div class="text-end mt-3">

        <h4>
            Total Amount:
            @Model.TotalAmount.ToString("0.00")
        </h4>

    </div>

</div>