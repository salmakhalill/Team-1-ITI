@model Team_1_ITI.ViewModels.Sales.SaleCreateViewModel

@{
    ViewData["Title"] = "Create Sale";
    var products = ViewBag.Products as List<Team_1_ITI.Models.Product>;
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-back d-inline-flex align-items-center px-3 py-2">
        <i data-lucide="arrow-left" class="me-2" width="16"></i> Back to List
    </a>
</div>

<div class="mb-4">
    <h2 class="mb-1 page-title-main">New Sale Record</h2>
    <p class="text-muted small m-0">Process a new customer transaction</p>
</div>

<form asp-controller="Sales" asp-action="Create" method="post" class="dynamic-form" novalidate>
    <div class="row">
        <!-- Customer Information -->
        <div class="col-12 mb-4">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-body p-4">
                    <div class="row g-4">
                        <div class="col-md-12">
                            <label asp-for="CustomerInfo" class="custom-form-label mb-2">Customer Information</label>
                            <input asp-for="CustomerInfo" class="form-control custom-input" maxlength="100" placeholder="Enter customer name or phone" />
                            <span asp-validation-for="CustomerInfo" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Products Table -->
        <div class="col-12 mb-4">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-white py-3 px-4 d-flex justify-content-between align-items-center border-bottom border-light">
                    <h5 class="mb-0 table-value-main">Sold Products</h5>
                    <button type="button" id="btn-add-item" class="btn btn-sm btn-light-theme d-flex align-items-center px-3 py-2">
                        <i data-lucide="plus" width="16" class="me-1"></i> Add Product
                    </button>
                </div>
                <div class="card-body p-0">
                    <table class="table align-middle mb-0">
                        <thead class="table-header-custom">
                            <tr>
                                <th width="45%" class="ps-4 py-3">PRODUCT</th>
                                <th width="15%" class="py-3">QUANTITY</th>
                                <th width="20%" class="py-3">UNIT PRICE ($)</th>
                                <th width="15%" class="py-3">LINE TOTAL</th>
                                <th width="5%" class="text-center py-3"></th>
                            </tr>
                        </thead>
                        <tbody id="items-tbody">
                            <tr class="item-row">
                                <td class="ps-4 py-3">
                                    <select name="Items[0].ProductID" class="form-select product-select border-0 bg-light" data-val="true" data-val-required="Please select a product">
                                        <option value="">-- Select Product --</option>
                                        @if (products != null)
                                        {
                                            foreach (var product in products)
                                            {
                                                <option value="@product.ProductID" data-price="@product.UnitPrice" data-stock="@product.StockQuantity">
                                                    @product.ProductName
                                                </option>
                                            }
                                        }
                                    </select>
                                    <span class="text-danger small field-validation-valid" data-valmsg-for="Items[0].ProductID" data-valmsg-replace="true"></span>
                                </td>
                                <td>
                                    <input type="number" name="Items[0].Quantity" class="form-control qty-input calc-input border-0 bg-light" min="1" value="1" data-val="true" data-val-required="Quantity is required" />
                                    <span class="text-danger small field-validation-valid" data-valmsg-for="Items[0].Quantity" data-valmsg-replace="true"></span>
                                </td>
                                <td>
                                    <input type="number" name="Items[0].UnitPrice" class="form-control cost-input calc-input border-0 bg-light" readonly value="0.00" />
                                </td>
                                <td class="fw-bold line-total text-theme">$0.00</td>
                                <td class="text-center pe-3">
                                    <button type="button" class="btn btn-sm btn-light text-danger btn-remove rounded-circle">
                                        <i data-lucide="trash-2" class="m-0" width="16" style="pointer-events: none;"></i>
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Summary & Submit -->
        <div class="col-12 d-flex justify-content-end mb-5">
            <div class="summary-container">
                <div class="summary-box mb-3 d-flex justify-content-between align-items-center">
                    <span class="text-secondary fw-bold">Total Amount</span>
                    <span id="grand-total" class="text-theme fs-4 fw-bolder">$0.00</span>
                </div>
                <button type="submit" class="btn btn-theme w-100 py-3 rounded-3 fw-bold fs-6">
                    Complete Sale
                </button>
            </div>
        </div>
    </div>
</form>

<!-- Hidden Template for New Rows -->
<table class="d-none">
    <tbody id="row-template">
        <tr class="item-row">
            <td class="ps-4 py-3">
                <select name="Items[0].ProductID" class="form-select product-select border-0 bg-light" data-val="true" data-val-required="Please select a product">
                    <option value="">-- Select Product --</option>
                    @if (products != null)
                    {
                        foreach (var product in products)
                        {
                            <option value="@product.ProductID" data-price="@product.UnitPrice" data-stock="@product.StockQuantity">
                                @product.ProductName
                            </option>
                        }
                    }
                </select>
                <span class="text-danger small field-validation-valid" data-valmsg-for="Items[0].ProductID" data-valmsg-replace="true"></span>
            </td>
            <td>
                <input name="Items[0].Quantity" class="form-control qty-input calc-input border-0 bg-light" value="1" min="1" type="number" data-val="true" data-val-required="Quantity is required" />
                <span class="text-danger small field-validation-valid" data-valmsg-for="Items[0].Quantity" data-valmsg-replace="true"></span>
            </td>
            <td>
                <input name="Items[0].UnitPrice" class="form-control cost-input calc-input border-0 bg-light" readonly value="0.00" type="number" />
            </td>
            <td class="fw-bold line-total text-theme">$0.00</td>
            <td class="text-center pe-3">
                <button type="button" class="btn btn-sm btn-light text-danger btn-remove rounded-circle">
                    <i data-lucide="trash-2" class="m-0" width="16" style="pointer-events: none;"></i>
                </button>
            </td>
        </tr>
    </tbody>
</table>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/dynamic-form.js" asp-append-version="true"></script>
}