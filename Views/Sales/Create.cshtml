@model Team_1_ITI.ViewModels.Sales.SaleCreateViewModel

@{
    ViewData["Title"] = "Create Sale";

    var products =
        ViewBag.Products as List<Team_1_ITI.Models.Product>;
}

<div class="container mt-4">

    <h2 class="mb-4">Create Sale</h2>

    <form asp-controller="Sales"
          asp-action="Create"
          method="post"
          novalidate>

        <div class="mb-3">

            <label asp-for="CustomerInfo"
                   class="form-label">
                Customer Information
            </label>

            <input asp-for="CustomerInfo"
                   id="customerInfo"
                   class="form-control"
                   maxlength="100"
                   placeholder="Enter customer information" />

            <div id="customerInfoError"
                 class="text-danger">
            </div>

        </div>


        <h4>Sold Products</h4>

        <table class="table table-bordered">

            <thead>

                <tr>
                    <th>Product</th>
                    <th>Quantity</th>
                    <th>Unit Price</th>
                    <th>Line Total</th>
                    <th></th>
                </tr>

            </thead>


            <tbody id="itemsBody">

                <tr class="sale-item">

                    <!-- Product -->
                    <td>

                        <select name="Items[0].ProductID"
                                class="form-select product-select">

                            <option value="">
                                Select Product
                            </option>

                            @if (products != null)
                            {
                                foreach (var product in products)
                                {
                                    <option value="@product.ProductID"
                                            data-price="@product.UnitPrice"
                                            data-stock="@product.StockQuantity">

                                        @product.ProductName

                                    </option>
                                }
                            }

                        </select>

                        <!-- Product Validation -->
                        <div class="text-danger product-validation-message">
                        </div>

                    </td>


                    <!-- Quantity -->
                    <td>

                        <input type="number"
                               name="Items[0].Quantity"
                               class="form-control quantity-input"
                               min="1"
                               value="1" />

                        <!-- Quantity Validation -->
                        <div class="text-danger quantity-validation-message">
                        </div>

                    </td>


                    <!-- Unit Price -->
                    <td>

                        <span class="unit-price">
                            0.00
                        </span>

                    </td>


                    <!-- Line Total -->
                    <td>

                        <span class="line-total">
                            0.00
                        </span>

                    </td>


                    <!-- Remove -->
                    <td>

                        <button type="button"
                                class="btn btn-danger remove-item">
                            Remove
                        </button>

                    </td>

                </tr>

            </tbody>

        </table>


        <button type="button"
                id="addItem"
                class="btn btn-secondary mb-3">
            Add Product
        </button>


        <div class="text-end mb-3">

            <h4>
                Total:
                <span id="totalAmount">
                    0.00
                </span>
            </h4>

        </div>


        <button type="submit"
                class="btn btn-primary">
            Complete Sale
        </button>


        <a asp-controller="Sales"
           asp-action="Index"
           class="btn btn-secondary">
            Cancel
        </a>

    </form>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        let itemIndex = 1;


        // ==========================================
        // Update one row
        // ==========================================

        function updateRow(row) {

            const select =
                row.querySelector(".product-select");

            const quantityInput =
                row.querySelector(".quantity-input");

            const selectedOption =
                select.options[select.selectedIndex];


            const price =
                parseFloat(
                    selectedOption.dataset.price
                ) || 0;


            const quantity =
                parseInt(
                    quantityInput.value
                ) || 0;


            const lineTotal =
                price * quantity;


            row.querySelector(".unit-price")
                .textContent =
                price.toFixed(2);


            row.querySelector(".line-total")
                .textContent =
                lineTotal.toFixed(2);


            updateTotal();
        }


        // ==========================================
        // Update total
        // ==========================================

        function updateTotal() {

            let total = 0;


            document
                .querySelectorAll(".sale-item")
                .forEach(row => {

                    const lineTotal =
                        parseFloat(
                            row.querySelector(
                                ".line-total"
                            ).textContent
                        ) || 0;


                    total += lineTotal;

                });


            document.getElementById("totalAmount")
                .textContent =
                total.toFixed(2);
        }


        // ==========================================
        // Add new product row
        // ==========================================

        document.getElementById("addItem")
            .addEventListener("click", function () {

                const body =
                    document.getElementById(
                        "itemsBody"
                    );


                const firstRow =
                    document.querySelector(
                        ".sale-item"
                    );


                const newRow =
                    firstRow.cloneNode(true);


                newRow.querySelector(
                    ".product-select"
                ).name =
                    `Items[${itemIndex}].ProductID`;


                newRow.querySelector(
                    ".quantity-input"
                ).name =
                    `Items[${itemIndex}].Quantity`;


                newRow.querySelector(
                    ".product-select"
                ).value = "";


                newRow.querySelector(
                    ".quantity-input"
                ).value = 1;


                newRow.querySelector(
                    ".unit-price"
                ).textContent = "0.00";


                newRow.querySelector(
                    ".line-total"
                ).textContent = "0.00";


                // Clear Product validation
                newRow.querySelector(
                    ".product-validation-message"
                ).textContent = "";


                // Clear Quantity validation
                newRow.querySelector(
                    ".quantity-validation-message"
                ).textContent = "";


                newRow.querySelector(
                    ".product-select"
                ).classList.remove(
                    "is-invalid"
                );


                newRow.querySelector(
                    ".quantity-input"
                ).classList.remove(
                    "is-invalid"
                );


                body.appendChild(newRow);


                itemIndex++;

            });


        // ==========================================
        // Product selection change
        // ==========================================

        document.getElementById("itemsBody")
            .addEventListener("change", function (event) {

                if (
                    event.target.classList
                        .contains("product-select")
                ) {

                    updateRow(
                        event.target
                            .closest(".sale-item")
                    );

                }

            });


        // ==========================================
        // Quantity change
        // ==========================================

        document.getElementById("itemsBody")
            .addEventListener("input", function (event) {

                if (
                    event.target.classList
                        .contains("quantity-input")
                ) {

                    updateRow(
                        event.target
                            .closest(".sale-item")
                    );

                }

            });


        // ==========================================
        // Remove product row
        // ==========================================

        document.getElementById("itemsBody")
            .addEventListener("click", function (event) {

                if (
                    event.target.classList
                        .contains("remove-item")
                ) {

                    const rows =
                        document.querySelectorAll(
                            ".sale-item"
                        );


                    if (rows.length > 1) {

                        event.target
                            .closest(".sale-item")
                            .remove();


                        updateTotal();

                    }

                }

            });


        // ==========================================
        // Frontend Validation
        // ==========================================

        document.querySelector("form")
            .addEventListener("submit", function (event) {

                let isValid = true;


                // ==================================
                // Customer Information
                // ==================================

                const customerInfo =
                    document.getElementById(
                        "customerInfo"
                    );


                const customerInfoError =
                    document.getElementById(
                        "customerInfoError"
                    );


                customerInfoError.textContent = "";


                customerInfo.classList.remove(
                    "is-invalid"
                );


                if (
                    customerInfo.value.trim() === ""
                ) {

                    customerInfoError.textContent =
                        "Customer information is required.";


                    customerInfo.classList.add(
                        "is-invalid"
                    );


                    isValid = false;

                }


                // ==================================
                // Products
                // ==================================

                const rows =
                    document.querySelectorAll(
                        ".sale-item"
                    );


                const selectedProducts =
                    new Set();


                rows.forEach(row => {

                    const select =
                        row.querySelector(
                            ".product-select"
                        );


                    const quantityInput =
                        row.querySelector(
                            ".quantity-input"
                        );


                    const productValidationMessage =
                        row.querySelector(
                            ".product-validation-message"
                        );


                    const quantityValidationMessage =
                        row.querySelector(
                            ".quantity-validation-message"
                        );


                    // Clear old messages

                    productValidationMessage.textContent = "";

                    quantityValidationMessage.textContent = "";


                    // Remove old invalid styles

                    select.classList.remove(
                        "is-invalid"
                    );


                    quantityInput.classList.remove(
                        "is-invalid"
                    );


                    const productId =
                        select.value;


                    const quantity =
                        parseInt(
                            quantityInput.value
                        );


                    // ==================================
                    // Product required
                    // ==================================

                    if (!productId) {

                        productValidationMessage.textContent =
                            "Please select a product.";


                        select.classList.add(
                            "is-invalid"
                        );


                        isValid = false;

                        return;

                    }


                    // ==================================
                    // Quantity validation
                    // ==================================

                    if (
                        isNaN(quantity) ||
                        quantity <= 0
                    ) {

                        quantityValidationMessage.textContent =
                            "Quantity must be greater than zero.";


                        quantityInput.classList.add(
                            "is-invalid"
                        );


                        isValid = false;

                        return;

                    }


                    // ==================================
                    // Get selected product
                    // ==================================

                    const selectedOption =
                        select.options[
                            select.selectedIndex
                        ];


                    const stock =
                        parseInt(
                            selectedOption.dataset.stock
                        ) || 0;


                    // ==================================
                    // Stock validation
                    // ==================================

                    if (quantity > stock) {

                        quantityValidationMessage.textContent =
                            `Only ${stock} item(s) available in stock.`;


                        quantityInput.classList.add(
                            "is-invalid"
                        );


                        isValid = false;

                        return;

                    }


                    // ==================================
                    // Duplicate product
                    // ==================================

                    if (
                        selectedProducts.has(
                            productId
                        )
                    ) {

                        productValidationMessage.textContent =
                            "This product is already added.";


                        select.classList.add(
                            "is-invalid"
                        );


                        isValid = false;

                        return;

                    }


                    selectedProducts.add(
                        productId
                    );

                });


                // ==================================
                // Stop submission if invalid
                // ==================================

                if (!isValid) {

                    event.preventDefault();

                    return;

                }


                // ==================================
                // Re-number items before submit
                // ==================================

                rows.forEach((row, index) => {

                    row.querySelector(
                        ".product-select"
                    ).name =
                        `Items[${index}].ProductID`;


                    row.querySelector(
                        ".quantity-input"
                    ).name =
                        `Items[${index}].Quantity`;

                });

            });

    </script>
}