@model Team_1_ITI.ViewModels.Sales.SaleCreateViewModel

@{
    ViewData["Title"] = "Create Sale";
    var products = ViewBag.Products as List<Team_1_ITI.Models.Product>;
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-back d-inline-flex align-items-center px-3 py-2">
        <i data-lucide="arrow-left" class="me-2" width="16"></i> Back to List
    </a>
</div>

<div class="mb-4">
    <h2 class="mb-1 page-title-main">New Sale Record</h2>
    <p class="text-muted small m-0">Process a new customer transaction</p>
</div>

<form asp-controller="Sales" asp-action="Create" method="post" class="dynamic-form" novalidate>
    <div class="row">
        <div class="col-12 mb-4">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-body p-4">
                    <div class="row g-4">
                        <div class="col-md-12">
                            <label asp-for="CustomerInfo" class="custom-form-label mb-2">Customer Information</label>
                            <input asp-for="CustomerInfo" id="customerInfo" class="form-control custom-input" maxlength="100" placeholder="Enter customer name or phone" />
                            <div id="customerInfoError" class="text-danger small mt-1 d-block"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 mb-4">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-white py-3 px-4 d-flex justify-content-between align-items-center border-bottom border-light">
                    <h5 class="mb-0 table-value-main">Sold Products</h5>
                    <button type="button" id="addItem" class="btn btn-sm btn-light-theme d-flex align-items-center px-3 py-2">
                        <i data-lucide="plus" width="16" class="me-1"></i> Add Product
                    </button>
                </div>
                <div class="card-body p-0">
                    <table class="table align-middle mb-0">
                        <thead class="table-header-custom">
                            <tr>
                                <th width="45%" class="ps-4 py-3">PRODUCT</th>
                                <th width="15%" class="py-3">QUANTITY</th>
                                <th width="20%" class="py-3">UNIT PRICE ($)</th>
                                <th width="15%" class="py-3">LINE TOTAL</th>
                                <th width="5%" class="text-center py-3"></th>
                            </tr>
                        </thead>
                        <tbody id="itemsBody">
                            <tr class="sale-item item-row">
                                <td class="ps-4 py-3">
                                    <select name="Items[0].ProductID" class="form-select custom-select product-select border-0 bg-light">
                                        <option value="">-- Select Product --</option>
                                        @if (products != null)
                                        {
                                            foreach (var product in products)
                                            {
                                                <option value="@product.ProductID" data-price="@product.UnitPrice" data-stock="@product.StockQuantity">
                                                    @product.ProductName
                                                </option>
                                            }
                                        }
                                    </select>
                                    <div class="text-danger small product-validation-message mt-1"></div>
                                </td>
                                <td>
                                    <input type="number" name="Items[0].Quantity" class="form-control custom-input quantity-input border-0 bg-light" min="1" value="1" />
                                    <div class="text-danger small quantity-validation-message mt-1"></div>
                                </td>
                                <td class="text-secondary">$<span class="unit-price">0.00</span></td>
                                <td class="fw-bold text-theme">$<span class="line-total">0.00</span></td>
                                <td class="text-center pe-3">
                                    <button type="button" class="btn btn-sm btn-light text-danger remove-item rounded-circle">
                                        <i data-lucide="trash-2" class="m-0" width="16" style="pointer-events: none;"></i>
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-12 d-flex justify-content-end mb-5">
            <div class="summary-container">
                <div class="summary-box mb-3 d-flex justify-content-between align-items-center">
                    <span class="text-secondary fw-bold">Total Amount</span>
                    <span class="text-theme fs-4 fw-bolder">$<span id="totalAmount">0.00</span></span>
                </div>
                <button type="submit" class="btn btn-theme w-100 py-3 rounded-3 fw-bold fs-6">
                    Complete Sale
                </button>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/dynamic-form.js" asp-append-version="true"></script>
}