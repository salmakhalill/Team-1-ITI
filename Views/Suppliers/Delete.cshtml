@model Team_1_ITI.Models.Supplier

@{
    ViewData["Title"] = "Delete Supplier";
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-back d-inline-flex align-items-center px-3 py-2">
        <i data-lucide="arrow-left" class="me-2" width="16"></i> Back to Suppliers
    </a>
</div>

<div class="mb-4">
    <h2 class="mb-1 page-title-main">Delete Supplier</h2>
    <p class="text-muted small m-0">Review supplier details before removal</p>
</div>

<div class="row">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm border-0 rounded-3 mb-4">
            <div class="card-body p-4">

                <div class="d-flex align-items-start mb-4">
                    <div class="bg-light rounded p-3 me-3 text-danger">
                        <i data-lucide="trash-2" width="24"></i>
                    </div>
                    <div>
                        <h5 class="mb-1 table-value-main">@Model.SupplierName</h5>
                        <span class="text-muted small">Supplier ID: #@Model.SupplierID</span>
                    </div>
                </div>

                <div class="alert bg-light border border-warning rounded-3 p-3 mb-4 d-flex">
                    <i data-lucide="alert-triangle" width="24" class="text-warning me-3 flex-shrink-0 mt-1"></i>
                    <div>
                        <strong class="d-block text-dark mb-1">Warning: System Impact</strong>
                        <span class="text-secondary small">
                            Deleting this supplier may impact existing purchase records or cause the deletion to fail if there are active transactions linked to them.
                        </span>
                    </div>
                </div>

                <div class="bg-light p-3 rounded-3 mb-4 border">
                    <div class="row mb-2">
                        <div class="col-sm-4 text-muted small fw-bold text-uppercase">Contact</div>
                        <div class="col-sm-8 fw-medium table-value-main">@Model.ContactName</div>
                    </div>
                    <div class="row">
                        <div class="col-sm-4 text-muted small fw-bold text-uppercase">Email</div>
                        <div class="col-sm-8 text-secondary">@Model.Email</div>
                    </div>
                </div>

                <form asp-action="Delete" method="post" class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <input type="hidden" asp-for="SupplierID" />
                    <a asp-action="Index" class="btn btn-light border px-4 py-2 rounded-3">Cancel</a>
                    <button type="submit" class="btn btn-danger px-4 py-2 rounded-3 fw-bold">Delete Supplier</button>
                </form>

            </div>
        </div>
    </div>
</div>