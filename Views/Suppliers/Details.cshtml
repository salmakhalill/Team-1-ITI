@model Team_1_ITI.Models.Supplier

@{
    ViewData["Title"] = "Supplier Details";
}

<h1>Supplier Details</h1>

<div>
    <dl class="row">

        <dt class="col-sm-3">
            Supplier ID
        </dt>
        <dd class="col-sm-9">
            @Model.SupplierID
        </dd>

        <dt class="col-sm-3">
            Supplier Name
        </dt>
        <dd class="col-sm-9">
            @Model.SupplierName
        </dd>

        <dt class="col-sm-3">
            Contact Name
        </dt>
        <dd class="col-sm-9">
            @Model.ContactName
        </dd>

        <dt class="col-sm-3">
            Phone
        </dt>
        <dd class="col-sm-9">
            @Model.Phone
        </dd>

        <dt class="col-sm-3">
            Email
        </dt>
        <dd class="col-sm-9">
            @Model.Email
        </dd>

        <dt class="col-sm-3">
            Address
        </dt>
        <dd class="col-sm-9">
            @Model.Address
        </dd>

    </dl>
</div>

<hr />

<h2>Products Supplied</h2>

@if (Model.Purchases != null && Model.Purchases.Any())
{
    var products = Model.Purchases
        .SelectMany(p => p.PurchaseItems)
        .Where(pi => pi.Product != null)
        .Select(pi => pi.Product)
        .GroupBy(p => p.ProductID)
        .Select(g => g.First())
        .ToList();

    if (products.Any())
    {
        <table class="table table-bordered table-striped align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Product ID</th>
                    <th>SKU</th>
                    <th>Product Name</th>
                    <th>Unit Price</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var product in products)
                {
                    <tr>
                        <td>@product.ProductID</td>
                        <td>@product.SKU</td>
                        <td>@product.ProductName</td>
                        <td>@product.UnitPrice</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>No products supplied yet.</p>
    }
}
else
{
    <p>No products supplied yet.</p>
}

<a asp-action="Edit"
   asp-route-SupplierID="@Model.SupplierID"
   class="btn btn-warning">
    Edit
</a>

<a asp-action="Index"
   class="btn btn-secondary">
    Back
</a>