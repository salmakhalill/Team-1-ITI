@{
    ViewData["Title"] = "AI Assistant";
}

<div class="ai-page">

    <!-- Page Header -->
    <div class="ai-header">

        <h1>AI Inventory Assistant</h1>

        <p>
            Ask questions about inventory, sales, purchases, and suppliers.
        </p>

    </div>


    <!-- Chat -->
    <div class="ai-card">

        <!-- Messages -->
        <div class="chat-area" id="chatArea">

            <div class="message assistant-message">

                <div class="message-icon">
                    <i data-lucide="bot"></i>
                </div>

                <div class="message-bubble ai-response">

                    <p>
                        Hello! I'm your Inventory Assistant.
                    </p>

                    <p>
                        I can help you check stock, identify low-stock
                        products, review sales and purchases, and more.
                    </p>

                </div>

            </div>

        </div>


        <!-- Suggested Questions -->
        <div class="suggested-section">

            <div class="suggested-title">
                Suggested questions
            </div>

            <div class="suggested-buttons">

                <button onclick="askSuggestedQuestion(
                    'Which products are currently low in stock?'
                )">
                    Low Stock
                </button>

                <button onclick="askSuggestedQuestion(
                    'Which products are currently out of stock?'
                )">
                    Out of Stock
                </button>

                <button onclick="askSuggestedQuestion(
                    'Which products are selling the most?'
                )">
                    Best Sellers
                </button>

                <button onclick="askSuggestedQuestion(
                    'Show me the recent purchases.'
                )">
                    Recent Purchases
                </button>

                <button onclick="askSuggestedQuestion(
                    'Show me the recent sales.'
                )">
                    Recent Sales
                </button>

                <button onclick="askSuggestedQuestion(
                    'Show me all suppliers.'
                )">
                    Suppliers
                </button>

            </div>

        </div>


        <!-- Input -->
        <div class="chat-input-area">

            <input type="text"
                   id="question"
                   placeholder="Ask about inventory..."
                   autocomplete="off"
                   onkeydown="handleKeyDown(event)" />

            <button class="send-button"
                    onclick="askAI()">
                Send
            </button>

        </div>

    </div>

</div>


@section Styles {

    <link rel="stylesheet"
          href="~/css/ai-assistant.css"
          asp-append-version="true" />

}


@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

    <script src="~/js/ai-assistant.js"
            asp-append-version="true"></script>

}

