@model Team_1_ITI.ViewModels.Categories.CategoryEditViewModel

@{
    ViewData["Title"] = "Edit Category";
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-back d-inline-flex align-items-center px-3 py-2">
        <i data-lucide="arrow-left" class="me-2" width="16"></i> Back to List
    </a>
</div>

<div class="mb-4">
    <h2 class="mb-1 page-title-main">Edit Category</h2>
    <p class="text-muted small m-0">Update category details</p>
</div>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="CategoryID" />

    <div class="card shadow-sm border-0 rounded-3 mb-4">
        <div class="card-header bg-white py-3 px-4 border-bottom border-light">
            <h5 class="mb-0 table-value-main">Category Information</h5>
        </div>
        <div class="card-body p-4">
            <div class="row g-4">
                <div class="col-md-12">
                    <label asp-for="CategoryName" class="custom-form-label mb-2">Category Name</label>
                    <input asp-for="CategoryName" class="form-control custom-input" />
                    <span asp-validation-for="CategoryName" class="text-danger small mt-1 d-block"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Description" class="custom-form-label mb-2">Description</label>
                    <textarea asp-for="Description" class="form-control custom-input" rows="4"></textarea>
                    <span asp-validation-for="Description" class="text-danger small mt-1 d-block"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end mb-5 gap-2">
        <a asp-action="Index" class="btn btn-back px-4 py-2 rounded-3">Cancel</a>
        <button type="submit" class="btn btn-theme px-4 py-2 rounded-3 fw-bold">Update Category</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}