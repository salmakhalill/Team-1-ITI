@model Team_1_ITI.ViewModels.Categories.CategoryEditViewModel

@{
    ViewData["Title"] = "Edit Category";
}

<h1>Edit Category</h1>

<hr />

<div class="row">
    <div class="col-md-6">

        <form asp-action="Edit" method="post">

            <input type="hidden" asp-for="CategoryID" />

            <div class="mb-3">
                <label asp-for="CategoryName" class="form-label"></label>

                <input asp-for="CategoryName"
                       class="form-control" />

                <span asp-validation-for="CategoryName"
                      class="text-danger">
                </span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>

                <textarea asp-for="Description"
                          class="form-control"
                          rows="4"></textarea>

                <span asp-validation-for="Description"
                      class="text-danger">
                </span>
            </div>

            <button type="submit"
                    class="btn btn-primary">
                Save
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Back
            </a>

        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}