@model Team_1_ITI.ViewModels.Categories.CategoryAddViewModel

@{
    ViewData["Title"] = "Add Category";
}

<div class="mb-4">
    <a asp-action="Index"
       class="btn btn-back d-inline-flex align-items-center px-3 py-2">
        <i data-lucide="arrow-left" class="me-2" width="16"></i>
        Back to List
    </a>
</div>

<div class="mb-4">
    <h2 class="mb-1 page-title-main">Add Category</h2>
    <p class="text-muted small m-0">Create a new category</p>
</div>

<form asp-action="Create"
      method="post"
      class="dynamic-form"
      id="categoryForm">

    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3"></div>

    <div class="row">

        <div class="col-12 mb-4">

            <div class="card shadow-sm border-0 rounded-3">

                <!-- Card Header -->
                <div class="card-header bg-white py-3 px-4 d-flex align-items-center border-bottom border-light">
                    <div>
                        <h5 class="mb-1 table-value-main">
                            Category Information
                        </h5>

                        <p class="text-muted small mb-0">
                            Enter the category details below
                        </p>
                    </div>
                </div>

                <!-- Card Body -->
                <div class="card-body p-4">

                    <div class="row g-4">

                        <!-- Category Name -->
                        <div class="col-md-6">

                            <label asp-for="CategoryName"
                                   class="custom-form-label mb-2">
                                Category Name
                            </label>

                            <input asp-for="CategoryName"
                                   class="form-control custom-input"
                                   placeholder="Enter category name" />

                            <span asp-validation-for="CategoryName"
                                  class="text-danger small mt-1 d-block">
                            </span>

                        </div>

                        <!-- Description -->
                        <div class="col-12">

                            <label asp-for="Description"
                                   class="custom-form-label mb-2">
                                Description
                            </label>

                            <textarea asp-for="Description"
                                      class="form-control custom-input"
                                      rows="5"
                                      placeholder="Enter category description"></textarea>

                            <span asp-validation-for="Description"
                                  class="text-danger small mt-1 d-block">
                            </span>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <!-- Buttons -->
        <div class="col-12 d-flex justify-content-end mb-5">

            <div class="summary-container">

                <div class="d-flex gap-2">

                    <a asp-action="Index"
                       class="btn btn-secondary px-4 py-3 rounded-3">
                        Back
                    </a>

                    <button type="submit"
                            class="btn btn-theme px-4 py-3 rounded-3 fw-bold">
                        <i data-lucide="plus"
                           width="16"
                           class="me-1"></i>
                        Add Category
                    </button>

                </div>

            </div>

        </div>

    </div>

</form>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/dynamic-form.js"
            asp-append-version="true"></script>
}