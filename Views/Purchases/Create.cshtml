@model Team_1_ITI.ViewModels.Purchases.CreatePurchaseViewModel

@{
    ViewData["Title"] = "Create Purchase";
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-back d-inline-flex align-items-center px-3 py-2">
        <i data-lucide="arrow-left" class="me-2" width="16"></i> Back to List
    </a>
</div>

<div class="mb-4">
    <h2 class="mb-1 page-title-main">New Purchase Order</h2>
    <p class="text-muted small m-0">Create a new supply record</p>
</div>

<form asp-action="Create" method="post" class="dynamic-form" id="purchaseForm">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="row">
        <div class="col-12 mb-4">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-body p-4">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <label asp-for="SupplierId" class="custom-form-label mb-2">Supplier</label>
                            <select asp-for="SupplierId" class="form-select custom-select">
                                <option value="">-- Select Supplier --</option>
                                @foreach (var supplier in ViewBag.Suppliers)
                                {
                                    <option value="@supplier.SupplierID">@supplier.SupplierName</option>
                                }
                            </select>
                            <span asp-validation-for="SupplierId" class="text-danger small mt-1 d-block"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PurchaseDate" class="custom-form-label mb-2">Order Date</label>
                            <input asp-for="PurchaseDate" type="date" class="form-control custom-input" />
                            <span asp-validation-for="PurchaseDate" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 mb-4">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-white py-3 px-4 d-flex justify-content-between align-items-center border-bottom border-light">
                    <h5 class="mb-0 table-value-main">Order Items</h5>
                    <button type="button" id="btn-add-item" class="btn btn-sm btn-light-theme d-flex align-items-center px-3 py-2">
                        <i data-lucide="plus" width="16" class="me-1"></i> Add Row
                    </button>
                </div>
                <div class="card-body p-0">
                    <span asp-validation-for="Items" class="text-danger small ms-4 mt-2 d-block"></span>
                    
                    <table class="table align-middle mb-0" id="items-table">
                        <thead class="table-header-custom">
                            <tr>
                                <th width="45%" class="ps-4 py-3">PRODUCT</th>
                                <th width="15%" class="py-3">QUANTITY</th>
                                <th width="20%" class="py-3">UNIT COST ($)</th>
                                <th width="15%" class="py-3">LINE TOTAL</th>
                                <th width="5%" class="text-center py-3"></th>
                            </tr>
                        </thead>
                        <tbody id="items-tbody">
                            @for (int i = 0; i < Model.Items.Count; i++)
                            {
                                <tr class="item-row">
                                    <td class="ps-4 py-3">
                                        <select asp-for="Items[i].ProductId" class="form-select product-select border-0 bg-light">
                                            <option value="">-- Select --</option>
                                            @foreach (var product in ViewBag.Products)
                                            {
                                                <option value="@product.ProductID">@product.ProductName</option>
                                            }
                                        </select>
                                        <span asp-validation-for="Items[i].ProductId" class="text-danger small"></span>
                                    </td>
                                    <td>
                                        <input asp-for="Items[i].Quantity" class="form-control calc-input qty-input border-0 bg-light" min="1" type="number" />
                                        <span asp-validation-for="Items[i].Quantity" class="text-danger small"></span>
                                    </td>
                                    <td>
                                        <input asp-for="Items[i].UnitCost" class="form-control calc-input cost-input border-0 bg-light" min="0.01" step="0.01" type="number" />
                                        <span asp-validation-for="Items[i].UnitCost" class="text-danger small"></span>
                                    </td>
                                    <td class="fw-bold line-total text-theme">$0.00</td>
                                    <td class="text-center pe-3">
                                        <button type="button" class="btn btn-sm btn-light text-danger btn-remove rounded-circle">
                                            <i data-lucide="trash-2" class="m-0" width="16"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-12 d-flex justify-content-end mb-5">
            <div class="summary-container">
                <div class="summary-box mb-3 d-flex justify-content-between align-items-center">
                    <span class="text-secondary fw-bold">Total Amount</span>
                    <span id="grand-total" class="text-theme fs-4 fw-bolder">$0.00</span>
                </div>
                <button type="submit" class="btn btn-theme w-100 py-3 rounded-3 fw-bold fs-6">
                    Confirm & Save Purchase
                </button>
            </div>
        </div>
    </div>
</form>

<table class="d-none">
    <tbody id="row-template">
        <tr class="item-row">
            <td class="ps-4 py-3">
                <select class="form-select product-select border-0 bg-light" required>
                    <option value="">-- Select --</option>
                    @foreach (var product in ViewBag.Products)
                    {
                        <option value="@product.ProductID">@product.ProductName</option>
                    }
                </select>
            </td>
            <td>
                <input class="form-control calc-input qty-input border-0 bg-light" value="1" min="1" type="number" required />
            </td>
            <td>
                <input class="form-control calc-input cost-input border-0 bg-light" value="0.00" min="0.01" step="0.01" type="number" required />
            </td>
            <td class="fw-bold line-total text-theme">$0.00</td>
            <td class="text-center pe-3">
                <button type="button" class="btn btn-sm btn-light text-danger btn-remove rounded-circle">
                    <i data-lucide="trash-2" class="m-0" width="16"></i>
                </button>
            </td>
        </tr>
    </tbody>
</table>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/dynamic-form.js" asp-append-version="true"></script>
}