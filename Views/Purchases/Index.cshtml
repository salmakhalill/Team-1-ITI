@model Team_1_ITI.ViewModels.Purchases.PurchaseIndexViewModel

@{
    ViewData["Title"] = "Purchases";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1 page-title-main">Purchase History</h2>
        <p class="text-muted small m-0">Manage and track your supply orders</p>
    </div>
    <a asp-action="Create" class="btn btn-theme d-flex align-items-center gap-2 px-4 py-2 rounded-3">
        <i data-lucide="plus" width="18"></i> New Purchase
    </a>
</div>

<div class="card shadow-sm border-0 rounded-3 overflow-hidden">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0 text-secondary">
            <thead class="table-header-custom">
                <tr>
                    <th class="ps-4 py-3">Ref ID</th>
                    <th class="py-3">Supplier</th>
                    <th class="py-3">Date</th>
                    <th class="py-3">Total Amount</th>
                    <th class="text-center pe-4 py-3">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var purchase in Model.Purchases)
                {
                    <tr>
                        <td class="ps-4 table-value-main">#@purchase.PurchaseID</td>
                        <td class="fw-medium">@purchase.SupplierName</td>
                        <td>@purchase.PurchaseDate.ToString("MMM dd, yyyy")</td>
                        <td><span class="badge-theme">$@purchase.TotalAmount.ToString("N2")</span></td>
                        <td class="text-center pe-4">
                            <a asp-action="Details" asp-route-id="@purchase.PurchaseID"
                               class="btn btn-sm btn-light border" title="View Details">
                                Details
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.TotalPages > 0)
{
    <div class="d-flex justify-content-between align-items-center mt-4">
        <span class="text-secondary small">
            Showing Page <strong class="table-value-main">@Model.CurrentPage</strong> of <strong class="table-value-main">@Model.TotalPages</strong>
        </span>

        <div class="custom-pagination d-flex gap-2">
            <a asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)"
               class="@(Model.CurrentPage <= 1 ? "disabled" : "")">
                &laquo; Previous
            </a>

            <a asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)"
               class="@(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                Next &raquo;
            </a>
        </div>
    </div>
}