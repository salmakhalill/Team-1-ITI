@model int

<a asp-controller="Inventory" asp-action="LowStock"
   class="header-icon position-relative"
   title="@(Model > 0 ? $"{Model} item(s) need attention" : "No alerts")">

    <i data-lucide="bell"></i>

    @if (Model > 0)
    {
        <span class="position-absolute badge rounded-pill"
              style="top:2px; right:2px; background:var(--danger-text); color:#fff; font-size:10px; padding:2px 5px; line-height:1;">
            @Model
        </span>
    }
</a>
