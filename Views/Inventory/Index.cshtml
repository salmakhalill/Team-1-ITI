@model Team_1_ITI.ViewModels.Inventory.InventoryIndexViewModel

@{
    ViewData["Title"] = "Stock";
}

<div class="container-fluid">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="mb-1">Live Inventory Board</h2>

            <p class="text-muted mb-0">
                Monitor stock levels, thresholds, and overall inventory health in real-time.
            </p>
        </div>

        <div class="d-flex align-items-center gap-3">

            <form asp-controller="Inventory"
                  asp-action="Index"
                  method="get"
                  class="d-flex gap-2">

                <input type="text"
                       name="search"
                       value="@Model.SearchTerm"
                       class="form-control"
                       placeholder="Search by SKU or Name..." />

                <input type="hidden"
                       name="filter"
                       value="@Model.CurrentFilter" />

                <button type="submit"
                        class="btn btn-outline-secondary">
                    Search
                </button>

            </form>

            <a asp-controller="Inventory"
               asp-action="LowStock"
               class="btn btn-warning position-relative">

                Low Stock Alerts

                @if (Model.LowStockCount > 0)
                {
                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                        @Model.LowStockCount
                    </span>
                }

            </a>

        </div>

    </div>


    <!-- Statistics -->
    <div class="row g-3 mb-4">

        <!-- Total SKUs -->
        <div class="col-md-3">

            <div class="card">
                <div class="card-body">

                    <div class="text-muted mb-1">
                        TOTAL SKUS
                    </div>

                    <h3 class="mb-0">
                        @Model.TotalSKUs
                    </h3>

                </div>
            </div>

        </div>


        <!-- In Stock -->
        <div class="col-md-3">

            <div class="card">
                <div class="card-body">

                    <div class="text-muted mb-1">
                        IN STOCK
                    </div>

                    <h3 class="mb-0">
                        @Model.InStockCount
                    </h3>

                </div>
            </div>

        </div>


        <!-- Low Stock -->
        <div class="col-md-3">

            <div class="card">
                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <div class="text-muted mb-1">
                                LOW STOCK
                            </div>

                            <h3 class="mb-0">
                                @Model.LowStockCount
                            </h3>

                        </div>

                        @if (Model.LowStockCount > 0)
                        {
                            <span class="text-warning">
                                ⚠
                            </span>
                        }

                    </div>

                </div>
            </div>

        </div>


        <!-- Out of Stock -->
        <div class="col-md-3">

            <div class="card">
                <div class="card-body">

                    <div class="text-muted mb-1">
                        OUT OF STOCK
                    </div>

                    <h3 class="mb-0">
                        @Model.OutOfStockCount
                    </h3>

                </div>
            </div>

        </div>

    </div>


    <!-- Filters / Tabs -->
    <div class="d-flex justify-content-between align-items-center mb-3">

        <div class="d-flex gap-2">

            <!-- All Items -->
            <a asp-controller="Inventory"
               asp-action="Index"
               asp-route-filter="All"
               class="btn @(Model.CurrentFilter == "All"
                                                  ? "btn-primary"
                                                  : "btn-outline-secondary")">

                All Items

                <span class="badge bg-light text-dark">
                    @Model.TotalSKUs
                </span>

            </a>


            <!-- In Stock -->
            <a asp-controller="Inventory"
               asp-action="Index"
               asp-route-filter="InStock"
               class="btn @(Model.CurrentFilter == "InStock"
                                                  ? "btn-primary"
                                                  : "btn-outline-secondary")">

                In Stock

                <span class="badge bg-light text-dark">
                    @Model.InStockCount
                </span>

            </a>


            <!-- Low Stock -->
            <a asp-controller="Inventory"
               asp-action="Index"
               asp-route-filter="LowStock"
               class="btn @(Model.CurrentFilter == "LowStock"
                                                  ? "btn-primary"
                                                  : "btn-outline-secondary")">

                Low Stock

                <span class="badge bg-light text-dark">
                    @Model.LowStockCount
                </span>

            </a>


            <!-- Out of Stock -->
            <a asp-controller="Inventory"
               asp-action="Index"
               asp-route-filter="OutOfStock"
               class="btn @(Model.CurrentFilter == "OutOfStock"
                                                  ? "btn-primary"
                                                  : "btn-outline-secondary")">

                Out of Stock

                <span class="badge bg-light text-dark">
                    @Model.OutOfStockCount
                </span>

            </a>

        </div>

    </div>


    <!-- Stock Table -->
    <div class="card">

        <div class="card-body">

            <div class="mb-3">

                <h5 class="mb-1">
                    Current Stock
                </h5>

                <p class="text-muted mb-0">
                    Current inventory status for all products
                </p>

            </div>


            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>

                        <tr>

                            <th>
                                SKU
                            </th>

                            <th>
                                PRODUCT
                            </th>

                            <th>
                                CATEGORY
                            </th>

                            <th>
                                CURRENT STOCK
                            </th>

                            <th>
                                LOW STOCK THRESHOLD
                            </th>

                            <th>
                                STOCK STATUS
                            </th>

                            <th>
                                ACTIONS
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (Model.Products.Any())
                        {
                            foreach (var product in Model.Products)
                            {
                                string status;

                                if (product.StockQuantity == 0)
                                {
                                    status = "Out of Stock";
                                }
                                else if (
                                    product.StockQuantity
                                    <= product.LowStockThreshold)
                                {
                                    status = "Low Stock";
                                }
                                else
                                {
                                    status = "In Stock";
                                }


                                <tr>

                                    <!-- SKU -->
                                    <td>
                                        @product.SKU
                                    </td>


                                    <!-- Product -->
                                    <td>

                                        <strong>
                                            @product.ProductName
                                        </strong>

                                    </td>


                                    <!-- Category -->
                                    <td>
                                        @(product.Category?.CategoryName ?? "-")
                                    </td>


                                    <!-- Current Stock -->
                                    <td>

                                        @product.StockQuantity

                                    </td>


                                    <!-- Threshold -->
                                    <td>

                                        @product.LowStockThreshold

                                    </td>


                                    <!-- Status -->
                                    <td>

                                        @if (status == "Out of Stock")
                                        {
                                            <span class="badge bg-danger">
                                                Out of Stock
                                            </span>
                                        }
                                        else if (status == "Low Stock")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Low Stock
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">
                                                In Stock
                                            </span>
                                        }

                                    </td>


                                    <!-- Actions -->
                                    <td>

                                        <a asp-controller="Product"
                                           asp-action="Details"
                                           asp-route-id="@product.ProductID"
                                           class="btn btn-sm btn-info">

                                            Details

                                        </a>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="7"
                                    class="text-center py-4">

                                    No products found.

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>