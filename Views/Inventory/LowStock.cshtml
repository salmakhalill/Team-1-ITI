@model List<Team_1_ITI.Models.Product>

@{
    ViewData["Title"] = "Action Required";
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-back d-inline-flex align-items-center px-3 py-2 mb-3">
        <i data-lucide="arrow-left" class="me-2" width="16"></i> Back to Inventory
    </a>
    <h2 class="mb-1 page-title-main">Action Required</h2>
    <p class="text-muted small m-0">Products that have fallen below their minimum stock threshold.</p>
</div>

@if (Model.Any())
{
    <div class="row g-4">
        @foreach (var product in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card shadow-sm border-0 rounded-3 h-100">
                    <div class="card-body p-4 d-flex flex-column">

                        <div class="mb-3">
                            <h6 class="mb-1 table-value-main">@product.ProductName</h6>
                            <span class="text-muted small">SKU: @product.SKU</span>
                        </div>

                        <hr class="text-muted opacity-25 my-3">

                        <div class="row mb-4">
                            <div class="col-6">
                                <span class="custom-form-label d-block mb-1">Current Stock</span>
                                <strong class="text-danger fs-5">@product.StockQuantity</strong>
                            </div>
                            <div class="col-6">
                                <span class="custom-form-label d-block mb-1">Threshold</span>
                                <strong class="table-value-main fs-5">@product.LowStockThreshold</strong>
                            </div>
                        </div>

                        <div class="mt-auto">
                            <a asp-controller="Purchases" asp-action="Create" asp-route-productId="@product.ProductID" class="btn btn-theme w-100 py-2 rounded-3 d-flex justify-content-center align-items-center">
                                <i data-lucide="shopping-cart" width="18" class="me-2"></i> Order Replenishment
                            </a>
                        </div>

                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body text-center py-5">
            <h6 class="table-value-main mb-1">Inventory is Healthy</h6>
            <p class="text-muted small mb-0">All products have sufficient stock levels.</p>
        </div>
    </div>
}