@model List<Team_1_ITI.Models.Product>

@{
    ViewData["Title"] = "Action Required";
}

<div class="container-fluid">

    <div class="mb-4">
        <h2 class="mb-1">
            Action Required
        </h2>

        <p class="text-muted mb-0">
            The following products have low stock levels and may need replenishment.
        </p>
    </div>


    @if (Model.Any())
    {
        <div class="row g-4">

            @foreach (var product in Model)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="card shadow-sm border-0 h-100">

                        <div class="card-body">

                            <div class="d-flex justify-content-between align-items-start mb-3">

                                <div>
                                    <h5 class="mb-1">
                                        @product.ProductName
                                    </h5>

                                    <small class="text-muted">
                                        SKU: @product.SKU
                                    </small>
                                </div>

                                <span class="badge bg-warning text-dark">
                                    Low Stock
                                </span>

                            </div>


                            <div class="row mb-4">

                                <div class="col-6">

                                    <div class="text-muted small">
                                        Current Stock
                                    </div>

                                    <strong class="fs-5">
                                        @product.StockQuantity
                                    </strong>

                                </div>


                                <div class="col-6">

                                    <div class="text-muted small">
                                        Threshold
                                    </div>

                                    <strong class="fs-5">
                                        @product.LowStockThreshold
                                    </strong>

                                </div>

                            </div>


                            <a asp-controller="Purchases"
                               asp-action="Create"
                               asp-route-productId="@product.ProductID"
                               class="btn btn-primary w-100">

                                Order Now

                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">

            <div class="card-body text-center py-5">

                <h5>
                    No low-stock products
                </h5>

                <p class="text-muted mb-0">
                    All products have sufficient stock.
                </p>

            </div>

        </div>
    }

</div>