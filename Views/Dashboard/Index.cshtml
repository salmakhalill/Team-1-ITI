@model Team_1_ITI.ViewModels.Dashboard.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<link rel="stylesheet"
      href="~/css/dashboard.css"
      asp-append-version="true" />

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />


<div class="dashboard-content">

    <!-- Dashboard Header -->
    <div class="dashboard-header">
        <div>
            <h1>Dashboard</h1>
            <p>Overview of your inventory and business activity.</p>
        </div>
    </div>


    <!-- ================= KPI CARDS ================= -->

    <div class="stats">

        <!-- Total Products -->
        <div class="stat-card">
            <div>
                <span class="stat-label">TOTAL PRODUCTS</span>
                <h2>@Model.TotalProducts</h2>
                <p>Products in inventory</p>
            </div>

            <div class="stat-icon green">
                <i class="bi bi-box-seam"></i>
            </div>
        </div>


        <!-- Categories -->
        <div class="stat-card">
            <div>
                <span class="stat-label">TOTAL CATEGORIES</span>
                <h2>@Model.TotalCategories</h2>
                <p>Active categories</p>
            </div>

            <div class="stat-icon blue">
                <i class="bi bi-grid"></i>
            </div>
        </div>


        <!-- Suppliers -->
        <div class="stat-card">
            <div>
                <span class="stat-label">TOTAL SUPPLIERS</span>
                <h2>@Model.TotalSuppliers</h2>
                <p>Registered suppliers</p>
            </div>

            <div class="stat-icon purple">
                <i class="bi bi-truck"></i>
            </div>
        </div>


        <!-- Stock Quantity -->
        <div class="stat-card">
            <div>
                <span class="stat-label">STOCK QUANTITY</span>
                <h2>@Model.StockQuantity.ToString("N0")</h2>
                <p>Total units</p>
            </div>

            <div class="stat-icon green">
                <i class="bi bi-boxes"></i>
            </div>
        </div>


        <!-- Low Stock -->
        <div class="stat-card">
            <div>
                <span class="stat-label">LOW STOCK PRODUCTS</span>
                <h2>@Model.LowStockCount</h2>
                <p class="warning">Needs replenishment</p>
            </div>

            <div class="stat-icon orange">
                <i class="bi bi-exclamation-triangle"></i>
            </div>
        </div>


        <!-- Purchases -->
        <div class="stat-card">
            <div>
                <span class="stat-label">TOTAL PURCHASES</span>
                <h2>$@Model.TotalPurchases.ToString("N2")</h2>
                <p>Purchase value</p>
            </div>

            <div class="stat-icon blue">
                <i class="bi bi-cart3"></i>
            </div>
        </div>


        <!-- Sales -->
        <div class="stat-card">
            <div>
                <span class="stat-label">TOTAL SALES</span>
                <h2>$@Model.TotalSales.ToString("N2")</h2>
                <p class="success">Revenue generated</p>
            </div>

            <div class="stat-icon green">
                <i class="bi bi-cash-stack"></i>
            </div>
        </div>


        <!-- Stock Value -->
        <div class="stat-card">
            <div>
                <span class="stat-label">STOCK VALUE</span>
                <h2>$@Model.StockValue.ToString("N2")</h2>
                <p>Current inventory value</p>
            </div>

            <div class="stat-icon gray">
                <i class="bi bi-layers"></i>
            </div>
        </div>

    </div>


    <!-- ================= MIDDLE SECTION ================= -->

   <div class="middle-grid">


    <!-- SALES OVERVIEW -->

    <div class="panel sales-panel">

        <div class="panel-title">

            <div>

                <h3>Sales Overview</h3>

                <p>
                    Monthly revenue for the last 6 months
                </p>

            </div>

            <span class="growth">
                ↗ 21.9%
            </span>

        </div>


        <div class="sales-chart">

                @{
                    var maxSale =
                        Model.MonthlySales.Any()
                        ? Model.MonthlySales.Max(x => x.Amount)
                        : 1;
                }

                @foreach (var sale in Model.MonthlySales)
                {
                    var height =
                        maxSale == 0
                        ? 5
                        : (double)(sale.Amount / maxSale) * 85;

                        <div class="chart-column">

                            <div class="bar"
                                 style="height:@height%">

                            </div>

                            <span>
                            @sale.Month
                            </span>

                        </div>
                }

        </div>

    </div>



    <!-- LOW STOCK -->

    <div class="panel">

        <div class="panel-title">

            <div>

                <h3>Low Stock</h3>

                <p>
                    Products needing replenishment
                </p>

            </div>

                <a asp-controller="Inventory" asp-action="Index">
                    View all
                </a>

        </div>


        <div class="low-stock">

                @foreach (var product in Model.LowStockProducts)
                {
                        <div class="stock-row">

                            <div class="product-symbol">
                                <i class="bi bi-box"></i>
                            </div>

                            <div class="product-details">

                                <strong>
                                @product.ProductName
                                </strong>

                                <span>
                                @product.SKU
                                </span>

                            </div>

                            <div class="stock-number">

                                <strong>
                                @product.StockQuantity pcs
                                </strong>

                                <span>
                                    Min @product.MinimumStock
                                </span>

                            </div>

                        </div>
                }

        </div>

    </div>

</div>



<!-- ================= BOTTOM ================= -->

<div class="bottom-grid">


    <!-- RECENT ACTIVITY -->

    <div class="panel recent-panel">

        <div class="panel-title">

            <div>

                <h3>Recent Activity</h3>

                <p>
                    Latest purchases and sales
                </p>

            </div>

        </div>


        <div class="table-container">

            <table>

                <thead>

                    <tr>

                        <th>TYPE</th>
                        <th>REFERENCE</th>
                        <th>PARTY</th>
                        <th>DATE</th>
                        <th>AMOUNT</th>

                    </tr>

                </thead>


                <tbody>

                        @foreach (var activity in Model.RecentActivities)
                        {
                                <tr>

                                    <td>

                                    @if (activity.Type == "Sale")
                                    {
                                                    <span class="sale-type">
                                                        ↗ Sale
                                                    </span>
                                    }
                                    else
                                    {
                                                    <span class="purchase-type">
                                                        ↘ Purchase
                                                    </span>
                                    }

                                    </td>

                                    <td>
                                        <strong>
                                        @activity.Reference
                                        </strong>
                                    </td>

                                    <td>
                                    @activity.Party
                                    </td>

                                    <td>
                                    @activity.Date.ToString("yyyy-MM-dd")
                                    </td>

                                    <td class="amount">
                                        $@activity.Amount.ToString("N2")
                                    </td>

                                </tr>
                        }

                </tbody>

            </table>

        </div>

    </div>



    <!-- MOST SOLD -->

    <div class="panel">

        <div class="panel-title">

            <div>

                <h3>Most Sold Products</h3>

                <p>
                    Top sellers this quarter
                </p>

            </div>

        </div>


        <div class="most-sold">

                @{
                    var maxSold =
                        Model.MostSoldProducts.Any()
                        ? Model.MostSoldProducts.Max(x => x.QuantitySold)
                        : 1;

                    int rank = 1;
                }


                @foreach (var product in Model.MostSoldProducts)
                {
                    var width =
                        (double)product.QuantitySold /
                        maxSold * 100;

                        <div class="sold-product">

                            <div class="sold-header">

                                <span>
                                @rank.
                                </span>

                                <strong>
                                @product.ProductName
                                </strong>

                                <label>
                                @product.QuantitySold sold
                                </label>

                            </div>


                            <div class="progress">

                                <div class="progress-bar"
                                     style="width:@width%">
                                </div>

                            </div>

                        </div>

                    rank++;
                }

        </div>

    </div>

</div>
