@model Team_1_ITI.ModelView.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<link rel="stylesheet"
      href="~/css/dashboard.css"
      asp-append-version="true" />

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />


<div class="dashboard">

    <!-- ================= SIDEBAR ================= -->

    <aside class="sidebar">

        <div class="brand">

            <div class="brand-logo">
                <i class="bi bi-boxes"></i>
            </div>

            <div>
                <h2>Stockwise</h2>
                <span>Inventory Management</span>
            </div>

        </div>


        <nav>

            <a asp-controller="Dashboard"
               asp-action="Index"
               class="nav-link active">

                <i class="bi bi-grid"></i>

                Dashboard

            </a>


            <div class="section-title">
                CATALOG
            </div>


            <a asp-controller="Products"
               asp-action="Index"
               class="nav-link">

                <i class="bi bi-box"></i>
                Products

            </a>


            <a asp-controller="Categories"
               asp-action="Index"
               class="nav-link">

                <i class="bi bi-diagram-3"></i>
                Categories

            </a>


            <a asp-controller="Suppliers"
               asp-action="Index"
               class="nav-link">

                <i class="bi bi-truck"></i>
                Suppliers

            </a>


            <div class="section-title">
                TRANSACTIONS
            </div>


            <a asp-controller="Purchases"
               asp-action="Index"
               class="nav-link">

                <i class="bi bi-cart3"></i>
                Purchases

            </a>


            <a asp-controller="Sales"
               asp-action="Index"
               class="nav-link">

                <i class="bi bi-receipt"></i>
                Sales

            </a>


            <div class="section-title">
                INVENTORY
            </div>


            <a href="#" class="nav-link">

                <i class="bi bi-boxes"></i>
                Stock

            </a>


            <div class="section-title">
                ANALYTICS
            </div>


            <a href="#" class="nav-link">

                <i class="bi bi-bar-chart"></i>
                Reports

            </a>


            <div class="section-title">
                ASSISTANT
            </div>


            <a href="#" class="nav-link">

                <i class="bi bi-chat-square-text"></i>
                AI Assistant

            </a>

        </nav>


        <!-- USER -->

        <div class="user-area">

            <div class="user-avatar">
                AM
            </div>

            <div>

                <strong>Alex Morgan</strong>

                <span>Inventory Manager</span>

            </div>

            <i class="bi bi-chevron-down"></i>

        </div>

    </aside>



    <!-- ================= MAIN ================= -->

    <main class="main">


        <!-- TOPBAR -->

        <header class="topbar">

            <div class="search">

                <i class="bi bi-search"></i>

                <input
                    type="text"
                    placeholder="Search products, orders, suppliers..." />

            </div>


            <div class="top-right">

                <i class="bi bi-question-circle"></i>

                <div class="notification">

                    <i class="bi bi-bell"></i>

                    <span></span>

                </div>

                <div class="top-avatar">
                    AM
                </div>

            </div>

        </header>



        <!-- CONTENT -->

        <section class="content">


            <!-- HEADER -->

            <div class="dashboard-header">

                <div>

                    <h1>Dashboard</h1>

                    <p>
                        Overview of your inventory and business activity.
                    </p>

                </div>

            </div>



            <!-- ================= KPI ================= -->

            <div class="stats">


                <div class="stat-card">

                    <div>
                        <label>TOTAL PRODUCTS</label>

                        <h2>
                            @Model.TotalProducts
                        </h2>

                        <small>
                            Products in inventory
                        </small>
                    </div>

                    <div class="stat-icon green">
                        <i class="bi bi-box"></i>
                    </div>

                </div>



                <div class="stat-card">

                    <div>
                        <label>TOTAL CATEGORIES</label>

                        <h2>
                            @Model.TotalCategories
                        </h2>

                        <small>
                            Active categories
                        </small>
                    </div>

                    <div class="stat-icon blue">
                        <i class="bi bi-diagram-3"></i>
                    </div>

                </div>



                <div class="stat-card">

                    <div>
                        <label>TOTAL SUPPLIERS</label>

                        <h2>
                            @Model.TotalSuppliers
                        </h2>

                        <small>
                            Registered suppliers
                        </small>
                    </div>

                    <div class="stat-icon purple">
                        <i class="bi bi-truck"></i>
                    </div>

                </div>



                <div class="stat-card">

                    <div>
                        <label>STOCK QUANTITY</label>

                        <h2>
                            @Model.StockQuantity.ToString("N0")
                        </h2>

                        <small>
                            Total units
                        </small>
                    </div>

                    <div class="stat-icon green">
                        <i class="bi bi-boxes"></i>
                    </div>

                </div>



                <div class="stat-card">

                    <div>
                        <label>LOW STOCK PRODUCTS</label>

                        <h2>
                            @Model.LowStockCount
                        </h2>

                        <small class="warning-text">
                            Needs replenishment
                        </small>
                    </div>

                    <div class="stat-icon orange">
                        <i class="bi bi-exclamation-triangle"></i>
                    </div>

                </div>



                <div class="stat-card">

                    <div>
                        <label>TOTAL PURCHASES</label>

                        <h2>
                            $@Model.TotalPurchases.ToString("N2")
                        </h2>

                        <small>
                            Purchase value
                        </small>
                    </div>

                    <div class="stat-icon blue">
                        <i class="bi bi-cart3"></i>
                    </div>

                </div>



                <div class="stat-card">

                    <div>
                        <label>TOTAL SALES</label>

                        <h2>
                            $@Model.TotalSales.ToString("N2")
                        </h2>

                        <small class="success-text">
                            Revenue generated
                        </small>
                    </div>

                    <div class="stat-icon green">
                        <i class="bi bi-cash-stack"></i>
                    </div>

                </div>



                <div class="stat-card">

                    <div>
                        <label>STOCK VALUE</label>

                        <h2>
                            $@Model.StockValue.ToString("N2")
                        </h2>

                        <small>
                            Current inventory value
                        </small>
                    </div>

                    <div class="stat-icon gray">
                        <i class="bi bi-layers"></i>
                    </div>

                </div>

            </div>



            <!-- ================= MIDDLE ================= -->

            <div class="middle-grid">


                <!-- SALES OVERVIEW -->

                <div class="panel sales-panel">

                    <div class="panel-title">

                        <div>

                            <h3>Sales Overview</h3>

                            <p>
                                Monthly revenue for the last 6 months
                            </p>

                        </div>

                        <span class="growth">
                            ↗ 21.9%
                        </span>

                    </div>


                    <div class="sales-chart">

                        @{
                            var maxSale =
                                Model.MonthlySales.Any()
                                ? Model.MonthlySales.Max(x => x.Amount)
                                : 1;
                        }

                        @foreach (var sale in Model.MonthlySales)
                        {
                            var height =
                                maxSale == 0
                                ? 5
                                : (double)(sale.Amount / maxSale) * 85;

                                <div class="chart-column">

                                    <div class="bar"
                                         style="height:@height%">

                                    </div>

                                    <span>
                                    @sale.Month
                                    </span>

                                </div>
                        }

                    </div>

                </div>



                <!-- LOW STOCK -->

                <div class="panel">

                    <div class="panel-title">

                        <div>

                            <h3>Low Stock</h3>

                            <p>
                                Products needing replenishment
                            </p>

                        </div>

                        <a href="#">
                            View all
                        </a>

                    </div>


                    <div class="low-stock">

                        @foreach (var product in Model.LowStockProducts)
                        {
                                <div class="stock-row">

                                    <div class="product-symbol">
                                        <i class="bi bi-box"></i>
                                    </div>

                                    <div class="product-details">

                                        <strong>
                                        @product.ProductName
                                        </strong>

                                        <span>
                                        @product.SKU
                                        </span>

                                    </div>

                                    <div class="stock-number">

                                        <strong>
                                        @product.StockQuantity pcs
                                        </strong>

                                        <span>
                                            Min @product.MinimumStock
                                        </span>

                                    </div>

                                </div>
                        }

                    </div>

                </div>

            </div>



            <!-- ================= BOTTOM ================= -->

            <div class="bottom-grid">


                <!-- RECENT ACTIVITY -->

                <div class="panel recent-panel">

                    <div class="panel-title">

                        <div>

                            <h3>Recent Activity</h3>

                            <p>
                                Latest purchases and sales
                            </p>

                        </div>

                    </div>


                    <div class="table-container">

                        <table>

                            <thead>

                                <tr>

                                    <th>TYPE</th>
                                    <th>REFERENCE</th>
                                    <th>PARTY</th>
                                    <th>DATE</th>
                                    <th>AMOUNT</th>

                                </tr>

                            </thead>


                            <tbody>

                                @foreach (var activity in Model.RecentActivities)
                                {
                                        <tr>

                                            <td>

                                            @if (activity.Type == "Sale")
                                            {
                                                        <span class="sale-type">
                                                            ↗ Sale
                                                        </span>
                                            }
                                            else
                                            {
                                                        <span class="purchase-type">
                                                            ↘ Purchase
                                                        </span>
                                            }

                                            </td>

                                            <td>
                                                <strong>
                                                @activity.Reference
                                                </strong>
                                            </td>

                                            <td>
                                            @activity.Party
                                            </td>

                                            <td>
                                            @activity.Date.ToString("yyyy-MM-dd")
                                            </td>

                                            <td class="amount">
                                                $@activity.Amount.ToString("N2")
                                            </td>

                                        </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>



                <!-- MOST SOLD -->

                <div class="panel">

                    <div class="panel-title">

                        <div>

                            <h3>Most Sold Products</h3>

                            <p>
                                Top sellers this quarter
                            </p>

                        </div>

                    </div>


                    <div class="most-sold">

                        @{
                            var maxSold =
                                Model.MostSoldProducts.Any()
                                ? Model.MostSoldProducts.Max(x => x.QuantitySold)
                                : 1;

                            int rank = 1;
                        }


                        @foreach (var product in Model.MostSoldProducts)
                        {
                            var width =
                                (double)product.QuantitySold /
                                maxSold * 100;

                                <div class="sold-product">

                                    <div class="sold-header">

                                        <span>
                                        @rank.
                                        </span>

                                        <strong>
                                        @product.ProductName
                                        </strong>

                                        <label>
                                        @product.QuantitySold sold
                                        </label>

                                    </div>


                                    <div class="progress">

                                        <div class="progress-bar"
                                             style="width:@width%">
                                        </div>

                                    </div>

                                </div>

                            rank++;
                        }

                    </div>

                </div>

            </div>


            <footer>
                © 2026 Stockwise. All rights reserved.
            </footer>

        </section>

    </main>

</div>