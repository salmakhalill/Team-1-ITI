@model Team_1_ITI.ViewModels.Products.ProductIndexViewModel

@{
    ViewData["Title"] = "Products";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1 page-title-main">Product Inventory</h2>
        <p class="text-muted small m-0">Manage catalog and stock levels.</p>
    </div>
    <a asp-action="Create" class="btn btn-theme d-flex align-items-center gap-2 px-4 py-2 rounded-3">
        <i data-lucide="plus" width="18"></i> Add Product
    </a>
</div>

<div class="card shadow-sm border-0 rounded-3 mb-4 bg-white">
    <div class="card-body p-3">
        <form asp-action="Index" method="get" class="row g-3 align-items-center">
            <div class="col-md-6">
                <input type="text" name="searchString" value="@Model.CurrentSearch" class="form-control custom-input" placeholder="Search by Name or SKU (Press Enter)..." />
            </div>
            <div class="col-md-3">
                <select name="categoryId" asp-items="ViewBag.Categories" class="form-select custom-input" onchange="this.form.submit()">
                    <option value="">All Categories</option>
                </select>
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select custom-input" onchange="this.form.submit()">
                    <option value="">All Statuses</option>
                    <option value="In Stock" selected="@(Model.CurrentStatus == "In Stock")">In Stock</option>
                    <option value="Low Stock" selected="@(Model.CurrentStatus == "Low Stock")">Low Stock</option>
                    <option value="Out of Stock" selected="@(Model.CurrentStatus == "Out of Stock")">Out of Stock</option>
                </select>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm border-0 rounded-3 overflow-hidden">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-header-custom">
                <tr>
                    <th class="ps-4 py-3">SKU</th>
                    <th class="py-3">PRODUCT</th>
                    <th class="py-3">PRICE</th>
                    <th class="py-3 text-center">STOCK</th>
                    <th class="py-3">STATUS</th>
                    <th class="text-center pe-4 py-3">ACTION</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Products.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">No products found.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model.Products)
                    {
                        string stockStatus = item.StockQuantity == 0 ? "Out of Stock" : (item.StockQuantity <= item.LowStockThreshold ? "Low Stock" : "In Stock");
                        <tr>
                            <td class="ps-4 text-secondary">@item.SKU</td>
                            <td class="fw-medium table-value-main">@item.ProductName</td>
                            <td class="text-secondary">@item.UnitPrice.ToString("C")</td>
                            <td class="text-center fw-bold @(stockStatus == "Out of Stock" ? "text-danger" : "table-value-main")">@item.StockQuantity</td>
                            <td>
                                @if (stockStatus == "Out of Stock")
                                {
                                    <span class="badge badge-status-danger">Out of Stock</span>
                                }
                                else if (stockStatus == "Low Stock")
                                {

                                    <span class="badge badge-status-warning">Low Stock Alert</span>
                                }
                                else
                                {

                                    <span class="badge badge-status-success">In Stock</span>
                                }
                            </td>
                            <td class="text-center pe-4">
                                <!-- Dropdown Menu -->
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-light border rounded-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i data-lucide="more-vertical" width="16" class="text-secondary"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-1">
                                        <li>
                                            <a class="dropdown-item d-flex align-items-center py-2" asp-action="Details" asp-route-id="@item.ProductID">
                                                <i data-lucide="eye" width="16" class="me-2 text-secondary"></i> View Details
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item d-flex align-items-center py-2" asp-action="Edit" asp-route-id="@item.ProductID">
                                                <i data-lucide="edit-2" width="16" class="me-2 text-secondary"></i> Edit
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <a class="dropdown-item d-flex align-items-center py-2 text-danger" asp-action="Delete" asp-route-id="@item.ProductID">
                                                <i data-lucide="trash-2" width="16" class="me-2"></i> Delete
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <div class="d-flex justify-content-between align-items-center mt-4">
        <span class="text-secondary small">
            Showing Page <strong class="table-value-main">@Model.CurrentPage</strong> of <strong class="table-value-main">@Model.TotalPages</strong>
        </span>
        <div class="custom-pagination d-flex gap-2">
            <a asp-action="Index" asp-route-pageNumber="@(Model.CurrentPage - 1)" asp-route-searchString="@Model.CurrentSearch" asp-route-categoryId="@Model.CurrentCategory" asp-route-status="@Model.CurrentStatus" class="@(Model.CurrentPage <= 1 ? "disabled" : "")">
                &laquo; Previous
            </a>
            <a asp-action="Index" asp-route-pageNumber="@(Model.CurrentPage + 1)" asp-route-searchString="@Model.CurrentSearch" asp-route-categoryId="@Model.CurrentCategory" asp-route-status="@Model.CurrentStatus" class="@(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                Next &raquo;
            </a>
        </div>
    </div>
}