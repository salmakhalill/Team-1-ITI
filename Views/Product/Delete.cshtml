@model Team_1_ITI.ViewModels.Products.ProductDetailsViewModel

@{
    ViewData["Title"] = "Delete Product";
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-back d-inline-flex align-items-center px-3 py-2 mb-3">
        <i data-lucide="arrow-left" class="me-2" width="16"></i> Back to Inventory
    </a>
    <h2 class="mb-1 page-title-main">Delete Product</h2>
    <p class="text-muted small m-0">Review product details before permanent removal.</p>
</div>

<div class="row">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm border-0 rounded-3 mb-4 bg-white">
            <div class="card-body p-4">
                <div class="d-flex align-items-start mb-4">
                    <div class="icon-box-danger rounded p-3 me-3">
                        <i data-lucide="trash-2" width="24"></i>
                    </div>
                    <div>
                        <h5 class="mb-1 table-value-main">@Model.ProductName</h5>
                        <span class="text-muted small">SKU: @Model.SKU | @Model.CategoryName</span>
                    </div>
                </div>

                <div class="alert bg-light border border-warning rounded-3 p-3 mb-4 d-flex">
                    <i data-lucide="alert-triangle" width="24" class="text-warning me-3 flex-shrink-0 mt-1"></i>
                    <div>
                        <strong class="d-block text-dark mb-1">Warning: System Impact</strong>
                        <span class="text-secondary small">
                            Deleting this product will remove it from the catalog. Proceed with caution.
                        </span>
                    </div>
                </div>

                <form asp-action="Delete" method="post" class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <input type="hidden" asp-for="ProductID" />
                    <a asp-action="Index" class="btn btn-light border px-4 py-2 rounded-3 text-secondary">Cancel</a>
                    <button type="submit" class="btn btn-danger px-4 py-2 rounded-3 fw-medium">Confirm Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>