@model Team_1_ITI.Models.Product
@{
ViewData["Title"] = "Delete Product";
}
<div class="row justify-content-center">
<div class="col-md-8">
<div class="card border-danger shadow-sm">
<div class="card-header bg-danger text-white">
<h4 class="mb-0">Are you sure you want to delete this product?</h4>
</div>
<div class="card-body">
<dl class="row fs-5">
<dt class="col-sm-4">Product Name:</dt>
<dd class="col-sm-8">@Model.ProductName</dd>
<dt class="col-sm-4">SKU:</dt>
<dd class="col-sm-8">@Model.SKU</dd>
<dt class="col-sm-4">Unit Price:</dt>
<dd class="col-sm-8">@Model.UnitPrice.ToString("C")</dd>
<dt class="col-sm-4">Current Stock:</dt>
<dd class="col-sm-8">@Model.StockQuantity</dd>
</dl>
<form asp-action="Delete" method="post" class="mt-4">
<input type="hidden" asp-for="ProductID" />
<div class="d-flex justify-content-between">
<a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
<button type="submit" class="btn btn-danger">Confirm Delete</button>
</div>
</form>
</div>
</div>
</div>
</div>