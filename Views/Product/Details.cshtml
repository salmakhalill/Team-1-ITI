@model Team_1_ITI.ViewModels.Products.ProductDetailsViewModel

@{
    ViewData["Title"] = "Product Details";
}

<div class="mb-4 d-flex justify-content-between align-items-center">
    <a asp-action="Index" class="btn btn-back d-inline-flex align-items-center px-3 py-2">
        <i data-lucide="arrow-left" class="me-2" width="16"></i> Back to Inventory
    </a>
    <a asp-action="Edit" asp-route-id="@Model.ProductID" class="btn btn-theme px-4 py-2 rounded-3 d-inline-flex align-items-center">
        <i data-lucide="edit-2" class="me-2" width="16"></i> Edit Product
    </a>
</div>

<div class="mb-4">
    <div class="d-flex align-items-center gap-3 mb-1">
        <h2 class="m-0 page-title-main">@Model.ProductName</h2>
        @if (Model.StockStatus == "Out of Stock")
        {
            <span class="badge badge-status-danger">Out of Stock</span>
        }
        else if (Model.StockStatus == "Low Stock")
        {
            <span class="badge badge-status-warning">Low Stock (@Model.StockQuantity left)</span>
        }
        else
        {
            <span class="badge badge-status-success">In Stock</span>
        }
    </div>
    <p class="text-muted small m-0">SKU: @Model.SKU</p>
</div>

<div class="row mb-4">
    <div class="col-md-6">
        <div class="card shadow-sm border-0 rounded-3 h-100 bg-white">
            <div class="card-body p-4">
                <span class="custom-form-label d-block mb-3 border-bottom pb-2">General Information</span>
                <div class="row mb-3">
                    <div class="col-sm-5 text-muted small fw-bold text-uppercase">Category</div>
                    <div class="col-sm-7 fw-medium table-value-main">@Model.CategoryName</div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-5 text-muted small fw-bold text-uppercase">SKU / Code</div>
                    <div class="col-sm-7 text-secondary">@Model.SKU</div>
                </div>
                <div class="row">
                    <div class="col-sm-5 text-muted small fw-bold text-uppercase">Unit Price</div>
                    <div class="col-sm-7 fw-bold text-success">@Model.UnitPrice.ToString("C")</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm border-0 rounded-3 h-100 bg-white">
            <div class="card-body p-4">
                <span class="custom-form-label d-block mb-3 border-bottom pb-2">Inventory Status</span>
                <div class="row mb-3">
                    <div class="col-sm-5 text-muted small fw-bold text-uppercase">Current Stock</div>
                    <div class="col-sm-7 fw-bold fs-5 @(Model.StockStatus == "Out of Stock" ? "text-danger" : "table-value-main")">
                        @Model.StockQuantity
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm-5 text-muted small fw-bold text-uppercase">Low Stock Alert At</div>
                    <div class="col-sm-7 text-secondary">@Model.LowStockThreshold units</div>
                </div>
            </div>
        </div>
    </div>
</div>